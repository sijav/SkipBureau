{
  "name": "@skipbureau/web",
  "description": "SkipBureau web app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "playwright install chromium",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:tsc": "npm run contract && npm run typecheck",
    "storybook": "storybook dev -p 6016 --ci",
    "build-storybook": "storybook build",
    "prebuild-storybook": "npm run i18n:compile",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "pretest:unit": "npm run i18n:compile",
    "test:storybook": "vitest run --project storybook",
    "pretest:storybook": "npm run i18n:compile",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "npm run i18n:compile",
    "test:e2e": "playwright test",
    "i18n:extract": "lingui extract",
    "i18n:compile": "lingui compile --namespace es",
    "predev": "npm run i18n:compile",
    "prebuild": "npm run i18n:compile",
    "pretest": "npm run i18n:compile",
    "prestorybook": "npm run i18n:compile",
    "schema": "npm run schema:emit -w @skipbureau/api",
    "codegen": "graphql-codegen --config codegen.ts",
    "contract": "npm run schema && npm run codegen",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lingui/core": "^6.5.0",
    "@lingui/react": "^6.5.0",
    "@mui/material": "^9.2.0",
    "@mui/stylis-plugin-rtl": "^9.1.1",
    "@mui/system": "^9.2.0",
    "graphql": "^16.14.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "stylis": "4.2.0",
    "urql": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@lingui/cli": "^6.5.0",
    "@lingui/format-po": "^6.5.0",
    "@lingui/swc-plugin": "^6.5.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lingui": "^0.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.0",
    "globals": "^17.7.0",
    "msw": "^2.15.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "storybook": "^10.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
